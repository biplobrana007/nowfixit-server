model User {
    id           String     @id @default(uuid())
    name         String     @db.VarChar(255)
    email        String     @unique
    password     String
    status       UserStatus @default(ACTIVE)
    profilePhoto String?
    role         Role

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("users")
}
