model Service {
    id          String  @id @default(uuid())
    title       String
    description String
    price       String
    isAvailable Boolean @default(true)
    duration    Float

    technicianId String
    user         User   @relation(fields: [technicianId], references: [id], onDelete: Cascade)

    categoryId String
    category   Category @relation(fields: [categoryId], references: [id])

    bookings Booking[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("services")
}
